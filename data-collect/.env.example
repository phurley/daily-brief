# Copy to `.env` and fill in if/when you want the commercial scraping-API
# fallback. This file is git-ignored. The API is ONLY a last resort, used when
# feeds + HTTP + curl_cffi + browser still produced no dated content.
#
# Pick ONE provider, paste your key, and leave the rest commented.
#
# SCRAPER_API_PROVIDER=scraperapi      # scraperapi | scrapingbee | scrapingant | generic
# SCRAPER_API_KEY=
#
# For `generic`, provide a URL template with {url} and {key} placeholders:
# SCRAPER_API_PROVIDER=generic
# SCRAPER_API_TEMPLATE=https://my-provider.example/api?key={key}&url={url}
#
# JS rendering is on by default; add --no-api-render (or set below) to save credits.
# SCRAPER_API_RENDER=false

# --- Jev candidate gate (extract/) ---
# Set one of these to run the live Jev gate. OpenRouter is preferred when both
# are present. Without a key the funnel uses the deterministic offline stub.
# OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=

# --- Extraction model (extract.pipeline) ---
# OpenRouter model used to turn accepted chunks into records. Defaults to the
# current successor of the benchmarked model; override to try another from
# gold/round2/MODEL-BENCH.md (e.g. google/gemini-2.5-flash, openai/gpt-4.1-mini).
# OPENROUTER_EXTRACT_MODEL=qwen/qwen3-32b
