# Local crawler environment and generated state.
.venv/
__pycache__/
*.pyc

# Secrets (API keys). Keep .env.example tracked.
.env
.env.*
!.env.example

# SQLite run log (local history; safe to delete, it is only a log).
crawl_log.db
crawl_log.db-journal
crawl_log.db-wal

# Latest good crawl results (regenerated by running the crawler).
crawl/

# Cron run output.
cron.log

# Processed extraction funnel output (regenerated by `python3 -m extract`).
processed/

# Hand-labeled gold/eval data (local only).
gold/