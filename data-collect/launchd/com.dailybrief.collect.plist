<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily Daily Brief collection job (01:30).

  Install (see README "Configure the daily job (launchd)"):
    cp launchd/com.dailybrief.collect.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dailybrief.collect.plist

  Edit the three /Users/phurley/daily-brief/data-collect paths below if this
  checkout lives somewhere else. launchd (not cron) is used because cron does
  not fire while the Mac is asleep; launchd runs a missed calendar slot on wake.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dailybrief.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/phurley/daily-brief/data-collect/run_collect.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/phurley/daily-brief/data-collect</string>

    <!-- Once a day, after the 00:05 edition rollover. Sources declare their
         own frequency (daily / 3days / weekly ...); a missed slot runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Canonical publication enabled for the household; fuzzy matching remains off. -->
        <key>EVENT_IDENTITY_MODE</key>
        <string>canonical</string>
        <key>EVENT_IDENTITY_FUZZY</key>
        <string>0</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/phurley/daily-brief/data-collect/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/phurley/daily-brief/data-collect/launchd.log</string>
</dict>
</plist>