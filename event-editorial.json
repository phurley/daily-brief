        "evidence": {
          "date": "Tue, Dec 1 2026",
          "time": "6:00pm",
          "venue": "Dana Natural Resources  Building",
          "admission": "Free",
          "description": "Countermapping is a radical way to use the tools of mapping in a way that engages with our environment in a politically explicit way. It can bring to light hidden histories of structural environmental discrimination, subvert dominant claims about space, and highlight ongoing struggles for decolonization and justice. In this workshop, we’ll think about the political dimensions of mapping, geography, and the environment, especially in the local context. Then, we’ll create our own countermaps using collage, a fun medium friendly to all levels of artistic experience. Plus, dinner is provided!",
          "registration": "Register here!",
          "end": "8:00pm"
        }
      },
