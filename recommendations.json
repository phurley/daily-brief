            "inputFacts": {
              "id": "occ-a2eae4776d477d910bd58249",
              "url": "https://events.umich.edu/event/152951",
              "start": "2026-11-16T16:00:00-05:00",
              "end": "2026-11-16T17:00:00-05:00",
