{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phurley.github.io/daily-brief/schemas/almanac.schema.json",
  "title": "Daily Brief Almanac",
  "description": "A rolling week of solar, lunar, and holiday facts for the Daily Brief.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "location", "days", "holidays", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "region", "latitude", "longitude", "timeZone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "timeZone": { "type": "string", "minLength": 1 }
      }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/day" }
    },
    "holidays": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/holiday" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "sunrise", "sunset", "moon"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "sunrise": { "type": "string", "format": "date-time" },
        "sunset": { "type": "string", "format": "date-time" },
        "solarNoon": { "type": "string", "format": "date-time" },
        "daylightMinutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "moon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "illuminationPercent", "summary", "imageAlt"],
          "properties": {
            "phase": {
              "enum": ["new", "waxing-crescent", "first-quarter", "waxing-gibbous", "full", "waning-gibbous", "last-quarter", "waning-crescent"]
            },
            "illuminationPercent": { "type": "number", "minimum": 0, "maximum": 100 },
            "moonrise": { "type": "string", "format": "date-time" },
            "moonset": { "type": "string", "format": "date-time" },
            "daysUntilFull": { "type": "integer", "minimum": 0, "maximum": 30 },
            "summary": { "type": "string", "minLength": 1 },
            "imageAlt": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "holiday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "date", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrievedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
