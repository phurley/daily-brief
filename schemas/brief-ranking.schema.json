{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Public compact-edition ranking configuration",
 "type":"object", "additionalProperties":false,
 "required":["schemaVersion","generatedAt","preferences","weights"],
 "properties":{
  "schemaVersion":{"const":"1.0.0"},"generatedAt":{"type":"string","format":"date-time"},
  "preferences":{"$ref":"preferences.schema.json"},
  "weights":{"type":"object","required":["base","scale","signals"],"properties":{"base":{"type":"number"},"scale":{"type":"number"},"signals":{"type":"object"}}}
 }
}
