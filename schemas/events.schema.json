{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phurley.github.io/daily-brief/schemas/events.schema.json",
  "title": "Daily Brief Events",
  "description": "Scored events for the Daily Brief. Bucketing (today/upcoming/past) is left to the consumer from editionDate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "editionDate", "events"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "editionDate": { "type": "string", "format": "date" },
    "events": {
      "type": "array",
      "description": "All scored events; no maximum.",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "start", "venue", "city", "category", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageAlt": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "format": "date-time", "description": "Verified absolute start date and time with timezone offset. Do not supply dateLabel or relative timing text such as today, tonight, tomorrow, or yesterday; the browser generates it." },
        "end": { "type": "string", "format": "date-time", "description": "Verified absolute closing date and time with timezone offset. Omit when unknown; never invent a closing time." },
        "venue": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "minLength": 1 },
        "ageRestriction": { "type": "string", "minLength": 1 },
        "registration": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "scoring": { "$ref": "#/$defs/scoring" },
        "distanceMiles": { "type": "number", "minimum": 0 },
        "deadline": { "type": "string", "minLength": 1 }
      }
    },
    "scoring": {
      "type": "object",
      "description": "Diagnostic breakdown behind the event-fit score, kept for tuning the weights in extract/scoring.py. Not surfaced in the UI.",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "signals": {
          "type": "object",
          "description": "Per-question Jev Noul P(yes), 0-1, keyed by question name.",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}