{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phurley.github.io/daily-brief/schemas/news.schema.json",
  "title": "Daily Brief News",
  "description": "The sourced local and regional news digest displayed by the Daily Brief.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "editionDate", "stories"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "editionDate": { "type": "string", "format": "date" },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "url", "source", "publishedAt", "addedAt", "localityIndex", "locations", "topics"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "photo": { "$ref": "#/$defs/photo" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "publication": { "type": "string", "minLength": 1 }
          }
        },
        "publishedAt": { "type": "string", "format": "date-time" },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the collector first found and added the story to the Daily Brief."
        },
        "localityIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Geographic relevance: 0 Canton/Plymouth; 1 immediately surrounding communities; 2 Ypsilanti/Ann Arbor; 3 Detroit and other metro Detroit suburbs; 4 statewide Michigan or elsewhere. Use the lowest applicable index."
        },
        "locations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "scoring": { "$ref": "#/$defs/scoring" }
      }
    },
    "scoring": {
      "type": "object",
      "description": "Diagnostic Jev scoring signals kept for tuning extract/scoring.py. The composite score is event-only, so stories normally carry only signals.",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "signals": {
          "type": "object",
          "description": "Per-question Jev Noul P(yes), 0-1, keyed by question name. Positive: funny, distinctive, live, eclectic, technical_science, artsy, progressive, outdoors, theatre. Negative: sporting, recurring, craft_fair_shopping, religious, large_venue, substance_recovery, popular_music_cover_band, market_or_shop, punk_metal_or_rock, dance, sales_related, children_activity, running, exercise, employment_related.",
          "properties": {
            "funny": { "type": "number", "minimum": 0, "maximum": 1 },
            "distinctive": { "type": "number", "minimum": 0, "maximum": 1 },
            "live": { "type": "number", "minimum": 0, "maximum": 1 },
            "eclectic": { "type": "number", "minimum": 0, "maximum": 1 },
            "technical_science": { "type": "number", "minimum": 0, "maximum": 1 },
            "artsy": { "type": "number", "minimum": 0, "maximum": 1 },
            "progressive": { "type": "number", "minimum": 0, "maximum": 1 },
            "outdoors": { "type": "number", "minimum": 0, "maximum": 1 },
            "theatre": { "type": "number", "minimum": 0, "maximum": 1 },
            "sporting": { "type": "number", "minimum": 0, "maximum": 1 },
            "recurring": { "type": "number", "minimum": 0, "maximum": 1 },
            "craft_fair_shopping": { "type": "number", "minimum": 0, "maximum": 1 },
            "religious": { "type": "number", "minimum": 0, "maximum": 1 },
            "large_venue": { "type": "number", "minimum": 0, "maximum": 1 },
            "substance_recovery": { "type": "number", "minimum": 0, "maximum": 1 },
            "popular_music_cover_band": { "type": "number", "minimum": 0, "maximum": 1 },
            "market_or_shop": { "type": "number", "minimum": 0, "maximum": 1 },
            "punk_metal_or_rock": { "type": "number", "minimum": 0, "maximum": 1 },
            "dance": { "type": "number", "minimum": 0, "maximum": 1 },
            "sales_related": { "type": "number", "minimum": 0, "maximum": 1 },
            "children_activity": { "type": "number", "minimum": 0, "maximum": 1 },
            "running": { "type": "number", "minimum": 0, "maximum": 1 },
            "exercise": { "type": "number", "minimum": 0, "maximum": 1 },
            "employment_related": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "alt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "alt": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
