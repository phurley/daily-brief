{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phurley.github.io/daily-brief/schemas/photos.schema.json",
  "title": "Daily Brief Photos",
  "description": "All discovered public still-photo candidates with the same original capture month and day in prior years. Presentation order is randomized by the client.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "timeZone",
    "collectionStart",
    "collectionEnd",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "timeZone": {
      "const": "America/Detroit"
    },
    "collectionStart": {
      "type": "string",
      "format": "date"
    },
    "collectionEnd": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 62,
      "description": "Available edition dates, sorted ascending with no duplicate dates. collectionStart and collectionEnd describe the bounds.",
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "photos"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last complete successful SmugMug API query for this date."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "photos": {
          "type": "array",
          "minItems": 0,
          "description": "Every candidate with a verified original takenDate matching this month and day in a prior year. No ratings or quality ordering are applied.",
          "items": {
            "$ref": "#/$defs/photo"
          }
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageUrl",
        "takenDate",
        "location",
        "description"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Stable source identity for future ratings." },
        "imageKey": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "takenDateSource": { "type": "string", "enum": ["ImageMetadata.DateTimeCreated", "ImageMetadata.DateCreated", "Image.DateTimeOriginal"] },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "A public direct URL to the actual photograph, not a gallery, album, API, or thumbnail page."
        },
        "takenDate": {
          "type": "string",
          "format": "date"
        },
        "location": {
          "type": "string",
          "description": "Explicit image location metadata; empty when unknown."
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
