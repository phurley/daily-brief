{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "lastSuccessfulCheckAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "documentGeneratedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "newestVerifiedStoryAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "staleAfterHours"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "staleAfterHours": {
            "type": "number",
            "minimum": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastAttemptAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastNewStoryAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 0
          },
          "acceptedCount": {
            "type": "integer",
            "minimum": 0
          },
          "deferredCount": {
            "type": "integer",
            "minimum": 0
          },
          "rejectedCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
