# Copy to `.env` (git-ignored) and fill in the key. The same file works for
# the crawler; vibe-check only reads OPENROUTER_API_KEY and the two overrides.

# Required: OpenRouter key used to write the daily editorial copy.
OPENROUTER_API_KEY=

# Optional: any low-cost, JSON-schema-capable OpenRouter model.
# Defaults to google/gemini-2.5-flash-lite (~$0.0004/run, ~1.5s).
# OPENROUTER_VIBE_MODEL=google/gemini-2.5-flash-lite

# Optional: keep messages for this many hours instead of the default 24.
# VIBE_RETENTION_HOURS=24